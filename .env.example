VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false

# Leave both blank to use the real project. To develop against a local
# Supabase stack instead (`npm run db:start`, then `npm run db:status` for
# these two values), copy this file to .env.local and fill them in there.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
